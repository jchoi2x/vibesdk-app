{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/nx.json", "{workspaceRoot}/tooling/**/*"]
  },
  "targetDefaults": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "inputs": ["default", "^default"]
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "inputs": ["default", "^default"]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"]
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"]
    },
    "cf-typegen": {
      "cache": false,
      "inputs": ["default", "^default"]
    },
    "publish": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
