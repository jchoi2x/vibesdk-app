{
  "name": "@jchoi2x/types",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core.js",
      "types": "./dist/core.d.ts"
    },
    "./errors": {
      "import": "./dist/errors.js",
      "types": "./dist/errors.d.ts"
    },
    "./vibesdk": {
      "import": "./dist/vibesdk/index.js",
      "types": "./dist/vibesdk/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup src/index.ts src/core.ts src/errors.ts src/vibesdk/index.ts --format esm --dts --clean --out-dir dist",
    "dev": "tsup src/index.ts src/core.ts src/errors.ts src/vibesdk/index.ts --format esm --dts --watch --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
