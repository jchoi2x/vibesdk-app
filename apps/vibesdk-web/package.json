{
  "name": "vibesdk-web",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "dependencies": {
    "@jchoi2x/types": "workspace:*"
  },
  "scripts": {
    "dev": "DEV_MODE=true vite",
    "build": "tsc -b --incremental && vite build",
    "typecheck": "tsc -b --incremental --noEmit",
