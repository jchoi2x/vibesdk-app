{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vibesdk-web",
  "observability": {
    "enabled": true,
  },
  "main": "./src/worker/app.ts",
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
    "binding": "ASSETS",
  },
  "compatibility_date": "2025-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "services": [{ "binding": "VIBESDK_API", "service": "vibesdk-api" }],
  "routes": [
    {
        "pattern": "vibesdk-web.megabyte.app",
        "custom_domain": true
    },
    {
        "pattern": "*vibesdk-web.megabyte.app/*",
        "custom_domain": false,
        "zone_id": "a70f14687a2194334e12062447e618f2"
    }
],
"workers_dev": false,
"preview_urls": false,
}
