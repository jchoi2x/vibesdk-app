{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secrets-store",
  "main": "src/index.ts",
  "dev": {
    "inspector_port": 9330,
    "port": 8081
  },
  "compatibility_date": "2025-08-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_VAULT",
        "class_name": "UserSecretsStore",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SecretsStore",
      ],
    },
    {
      "tag": "v2",
      "deleted_classes": [
        "SecretsStore",
      ],
      "new_sqlite_classes": [
        "UserSecretsStore",
      ],
    },
  ],
}
