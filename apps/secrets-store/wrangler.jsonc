{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secrets-store",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SECRETS_STORE",
        "class_name": "SecretsStore",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SecretsStore"
      ],
    },
  ],
}
