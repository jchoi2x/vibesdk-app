{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vibesdk-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-08-10",
	"compatibility_flags": ["nodejs_compat"],
	"dev": {
		"port": 8080,
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"unsafe": {
		"bindings": [
			{
				"name": "API_RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "2101",
				"simple": { "limit": 10000, "period": 60 }
			},
			{
				"name": "AUTH_RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "2102",
				"simple": { "limit": 1000, "period": 60 }
			}
		]
	},
	// Service bindings to the standalone rate-limit and secrets-store Workers.
	// These replace direct DO access for those concerns in the long run,
	// but the local DOs (DORateLimitStore, UserSecretsStore) remain until
	// the service layer migration is complete.
	"services": [
		{ "binding": "RATE_LIMIT", "service": "rate-limit" },
		{ "binding": "SECRETS_STORE", "service": "secrets-store" }
	],
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"dispatch_namespaces": [
		{
			"binding": "DISPATCHER",
			"namespace": "orange-build-default-namespace",
			"remote": true
		}
	],
	"containers": [
		{
			"class_name": "UserAppSandboxService",
			"image": "./SandboxDockerfile",
			// Altering max_instances value will have no effect. Please use the MAX_SANDBOX_INSTANCES var instead.
			"max_instances": 10,
			// ATTENTION: Altering instance_type value will have no effect. Please use the SANDBOX_INSTANCE_TYPE var instead.
			"instance_type": "standard-3",
			"rollout_step_percentage": 100
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vibesdk-db",
			"database_id": "4f1bec68-257e-4aa7-ac98-d2220046453d",
			"migrations_dir": "migrations",
			"remote": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "CodeGeneratorAgent",
				"name": "CodeGenObject"
			},
			{
				"class_name": "UserAppSandboxService",
				"name": "Sandbox"
			},
			{
				"class_name": "DORateLimitStore",
				"name": "DORateLimitStore"
			},
			{
				"class_name": "UserSecretsStore",
				"name": "UserSecretsStore"
			}
		]
	},
	"r2_buckets": [
		{
			"binding": "TEMPLATES_BUCKET",
			"bucket_name": "vibesdk-templates",
			"remote": true,
			"preview_bucket_name": "vibesdk-templates"
		}
	],
	"kv_namespaces": [
		{
			"binding": "VibecoderStore",
			"id": "e6c454eef8e542daaf98f5e3206d2dd7",
			"remote": true
		}
	],
	"migrations": [
		{
			"new_sqlite_classes": ["CodeGeneratorAgent", "UserAppSandboxService"],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": ["DORateLimitStore"],
			"tag": "v2"
		},
		{
			"new_sqlite_classes": ["UserSecretsStore"],
			"tag": "v3"
		}
	],
	"vars": {
		"ALLOWED_EMAIL": "choijjames@gmail.com",
		"ENABLE_READ_REPLICAS": "true",
		"CLOUDFLARE_AI_GATEWAY": "enl-ai-gateway",
		"PLATFORM_CAPABILITIES": {
			"features": {
				"app": {
					"enabled": true
				},
				"presentation": {
					"enabled": false
				},
				"general": {
					"enabled": false
				}
			},
			"version": "1.0.0"
		},
		"MAX_SANDBOX_INSTANCES": "10",
		"SANDBOX_INSTANCE_TYPE": "standard-3",
		"DISPATCH_NAMESPACE": "orange-build-default-namespace"
	},
	"workers_dev": false,
	"preview_urls": true,
	"routes": [
		{
			"pattern": "vibesdk-api.megabyte.app",
			"custom_domain": true
		},
		{
			"pattern": "*vibesdk-api.megabyte.app/*",
			"custom_domain": false,
			"zone_id": "a70f14687a2194334e12062447e618f2"
		}
	]
}
